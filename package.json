    "@supabase/supabase-js": "^2.118.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
