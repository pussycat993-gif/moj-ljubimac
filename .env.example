# Public base URL for links in emails and messages
NEXT_PUBLIC_SITE_URL=
# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous (public) key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key, server only
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare account id for the R2 endpoint
R2_ACCOUNT_ID=
# R2 access key
R2_ACCESS_KEY_ID=
# R2 secret key
R2_SECRET_ACCESS_KEY=
# Files bucket (attachments, photos, logos, exports/)
R2_BUCKET=
# Backups bucket — a separate bucket (ADR-13)
R2_BACKUP_BUCKET=
# Resend API key
RESEND_API_KEY=
# Sender address
EMAIL_FROM=
# VAPID public key for push subscription
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID private key (JWK)
VAPID_PRIVATE_KEY_JWK=
# VAPID subject (mailto: or site URL)
VAPID_SUBJECT=
# WhatsApp Cloud API phone number id
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Cloud API access token
WHATSAPP_ACCESS_TOKEN=
# Webhook signature verification
WHATSAPP_APP_SECRET=
# Webhook subscription verification
WHATSAPP_VERIFY_TOKEN=
# Shared secret for pg_cron → internal routes (matches Vault dispatch_secret)
DISPATCH_SECRET=
# Signing key for one-click action tokens (e.g. dn_)
ACTION_TOKEN_SECRET=
# Recipient of Operator alerts (RISK-14)
OPERATOR_ALERT_EMAIL=
